commands.water.desc = Set or add to a player's water (0-100): water set|add <amount> [player] (operators only)
commands.water.set.desc = Set water: water set <amount> [player]
commands.water.add.desc = Add to water: water add <amount> [player]
commands.exposure.desc = Set or add to a player's sun exposure (0-100): exposure set|add <amount> [player] (operators only)
commands.exposure.set.desc = Set exposure: exposure set <amount> [player]
commands.exposure.add.desc = Add to exposure: exposure add <amount> [player]
commands.waterdebug.desc = Print water, exposure, tier, multipliers and whether you are in the sun: waterdebug [player]
items.Arrakis_Litrejon.name = Litrejon
items.Arrakis_Litrejon.description = A reusable flask holding up to 500 units of water. Use it to drink 50 at a time; use it while looking at water to refill it. The durability bar shows how much water is left.
items.Arrakis_Burrow_Bulb.name = Burrow Bulb
items.Arrakis_Burrow_Bulb.description = A swollen desert bulb, full of moisture. Restores 25 water.
items.Arrakis_Spicebread.name = Spicebread
items.Arrakis_Spicebread.description = Dense, spiced bread. Restores health and a little water.
items.Arrakis_Desert_Game.name = Desert Game
items.Arrakis_Desert_Game.description = Roasted desert game on a skewer. A hearty meal that restores health and a little water.
waterOfArrakis.flaskFilled = You fill the Litrejon.
waterOfArrakis.flaskEmpty = The Litrejon is empty. Look at water and use it to refill.
waterOfArrakis.notThirsty = You are not thirsty.
items.Arrakis_Primrose.name = Desert Primrose
items.Arrakis_Primrose.description = A cluster of tiny desert flowers that hold a little water. They open in the evening.
items.Arrakis_Burrowbush.name = Burrowbush
items.Arrakis_Burrowbush.description = A scrubby bush with a Burrow Bulb buried under its roots. Gives one each day.
interactionHints.primrose = Drink
waterOfArrakis.hintPrimrose = Drink
waterOfArrakis.hintBurrowbush = Dig up a bulb
waterOfArrakis.hintBurrowbushDepleted = Picked over today
waterOfArrakis.primroseClosed = The primrose is closed. It opens in the evening.
waterOfArrakis.primroseDrink = You drink the dew from the primrose.
waterOfArrakis.bushDepleted = You have already dug up a bulb here today.
waterOfArrakis.bushBulb = You dig up a Burrow Bulb.
waterOfArrakis.bagFull = Your bag is full.
commands.waterplants.desc = Place primroses and burrowbushes on island rock in the loaded chunks around you: waterplants [radiusInChunks]
commands.sunprobe.desc = Debug the sun check: sunprobe [ray] shows what blocks each sample ray; sunprobe time shows the sun direction; sunprobe blocks [ids] shows what blocks report
